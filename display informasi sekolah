<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PPTQ Jasma Digital — Display Informasi</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Amiri:wght@400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
  :root {
    --bg-overlay: rgba(6, 24, 22, 0.82);
    --primary: #1a8a6f;
    --primary-dark: #0d5240;
    --primary-light: #4dd0a8;
    --accent: #f4c430;
    --accent-2: #ffd966;
    --accent-3: #ff8c42;
    --text: #ffffff;
    --text-muted: rgba(255, 255, 255, 0.72);
    --card-bg: rgba(255, 255, 255, 0.05);
    --card-border: rgba(255, 255, 255, 0.12);
    --danger: #ff5252;
    --success: #4caf50;
    --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Plus Jakarta Sans', sans-serif;
    color: var(--text);
    height: 100vh;
    overflow: hidden;
    position: relative;
    background: #061512;
  }

  #wallpaper-layer {
    position: fixed;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transition: background-image 0.6s ease;
    z-index: 0;
  }

  #wallpaper-layer::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--bg-overlay);
    backdrop-filter: blur(3px);
  }

  .pattern-overlay {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-image: 
      radial-gradient(circle at 15% 25%, rgba(26, 138, 111, 0.18) 0%, transparent 40%),
      radial-gradient(circle at 85% 75%, rgba(244, 196, 48, 0.12) 0%, transparent 40%);
  }

  .pattern-overlay::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: 
      repeating-linear-gradient(45deg, transparent, transparent 60px, rgba(255,255,255,0.02) 60px, rgba(255,255,255,0.02) 61px),
      repeating-linear-gradient(-45deg, transparent, transparent 60px, rgba(255,255,255,0.02) 60px, rgba(255,255,255,0.02) 61px);
  }

  .particles {
    position: fixed;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    overflow: hidden;
  }

  .particle {
    position: absolute;
    background: rgba(244, 196, 48, 0.35);
    border-radius: 50%;
    animation: float linear infinite;
  }

  @keyframes float {
    0% { transform: translateY(100vh); opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { transform: translateY(-10vh); opacity: 0; }
  }

  .display-container {
    position: relative;
    z-index: 10;
    width: 100vw;
    height: 100vh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0;
  }

  .display-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 14px 28px;
    background: linear-gradient(135deg, rgba(13, 82, 64, 0.95), rgba(6, 24, 22, 0.95));
    border-bottom: 3px solid var(--accent);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .school-logo {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--accent), var(--accent-3));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    color: #1a1a1a;
    font-weight: 900;
    box-shadow: 0 6px 20px rgba(244, 196, 48, 0.4);
    flex-shrink: 0;
  }

  .school-info h1 {
    font-size: 1.4rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.3px;
    background: linear-gradient(90deg, #fff, var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .school-info .subtitle {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-top: 3px;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .school-info .subtitle span {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .school-info .subtitle i {
    color: var(--primary-light);
    font-size: 0.7rem;
  }

  .header-center {
    text-align: center;
    padding: 0 20px;
  }

  .header-center .arabic {
    font-family: 'Amiri', serif;
    font-size: 1.2rem;
    color: var(--accent);
    margin-bottom: 2px;
  }

  .header-center .motto {
    font-size: 0.72rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .header-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
  }

  .datetime-box {
    text-align: right;
    background: rgba(0, 0, 0, 0.3);
    padding: 8px 16px;
    border-radius: 10px;
    border: 1px solid rgba(244, 196, 48, 0.2);
  }

  .datetime-box .day-date {
    font-size: 0.95rem;
    color: var(--accent);
    font-weight: 700;
    text-transform: capitalize;
  }

  .datetime-box .time {
    font-family: 'Orbitron', sans-serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: #fff;
    margin-top: 2px;
    letter-spacing: 1px;
  }

  .settings-btn {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    border: 1px solid var(--accent);
    background: rgba(244, 196, 48, 0.12);
    color: var(--accent);
    font-size: 1rem;
    cursor: pointer;
    transition: var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .settings-btn:hover {
    background: var(--accent);
    color: #1a1a1a;
    transform: rotate(45deg);
  }

  .main-content {
    display: grid;
    grid-template-columns: 1fr 1.3fr 1fr;
    gap: 16px;
    padding: 16px 20px;
    overflow: hidden;
  }

  .schedule-column {
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow: hidden;
  }

  .column-title {
    background: linear-gradient(135deg, var(--primary-dark), var(--primary));
    padding: 10px 16px;
    border-radius: 10px;
    text-align: center;
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    box-shadow: 0 4px 12px rgba(13, 82, 64, 0.4);
    border: 1px solid rgba(244, 196, 48, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .column-title i {
    color: var(--accent);
  }

  .schedule-list {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    overflow-y: auto;
    padding-right: 4px;
  }

  .schedule-card {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.03));
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 12px 14px;
    transition: var(--transition);
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
  }

  .schedule-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--primary-light);
  }

  .schedule-card.active {
    background: linear-gradient(135deg, rgba(244, 196, 48, 0.18), rgba(244, 196, 48, 0.05));
    border-color: var(--accent);
    box-shadow: 0 4px 20px rgba(244, 196, 48, 0.2);
    transform: scale(1.02);
  }

  .schedule-card.active::before {
    background: var(--accent);
    width: 5px;
  }

  .schedule-card.next::before {
    background: var(--accent-3);
  }

  .schedule-card .class-name {
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 6px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .schedule-card .class-name .badge {
    font-size: 0.6rem;
    padding: 2px 8px;
    background: var(--accent);
    color: #1a1a1a;
    border-radius: 50px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    white-space: nowrap;
  }

  .schedule-card.next .class-name .badge {
    background: var(--accent-3);
  }

  .schedule-card .class-time {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.85rem;
    color: var(--accent-2);
    margin-bottom: 4px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .schedule-card .class-subject {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .schedule-card .class-subject i {
    color: var(--primary-light);
    margin-right: 4px;
  }

  .center-column {
    display: flex;
    flex-direction: column;
    gap: 12px;
    overflow: hidden;
  }

  .building-image {
    flex: 1;
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    background: linear-gradient(135deg, var(--primary-dark), #061512);
    border: 1px solid var(--card-border);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
    min-height: 200px;
  }

  .building-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 10s ease;
  }

  .building-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgba(6, 24, 22, 0.9));
    pointer-events: none;
  }

  .building-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 16px 20px;
    z-index: 2;
  }

  .building-caption h2 {
    font-size: 1.3rem;
    font-weight: 800;
    color: #fff;
    text-shadow: 0 2px 10px rgba(0,0,0,0.8);
  }

  .building-caption p {
    font-size: 0.8rem;
    color: var(--accent-2);
    margin-top: 4px;
    text-shadow: 0 2px 8px rgba(0,0,0,0.8);
  }

  .clock-widget {
    background: linear-gradient(135deg, rgba(13, 82, 64, 0.6), rgba(6, 24, 22, 0.6));
    border: 1px solid var(--card-border);
    border-radius: 14px;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    backdrop-filter: blur(10px);
    flex-shrink: 0;
  }

  .clock-widget .clock-time {
    font-family: 'Orbitron', sans-serif;
    font-size: 2rem;
    font-weight: 900;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1;
  }

  .clock-widget .clock-seconds {
    font-family: 'Orbitron', sans-serif;
    font-size: 1.1rem;
    color: var(--accent-3);
  }

  .clock-widget .clock-label {
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-top: 4px;
  }

  .clock-widget .clock-icon {
    font-size: 1.8rem;
    color: var(--accent);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.95); }
  }

  .activity-progress-mini {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    padding: 10px 14px;
    border: 1px solid var(--card-border);
    flex-shrink: 0;
  }

  .activity-progress-mini .label {
    font-size: 0.7rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 6px;
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }

  .progress-bar-mini {
    height: 6px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    overflow: hidden;
    position: relative;
  }

  .progress-bar-mini-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--primary-light), var(--accent));
    border-radius: 10px;
    transition: width 1s linear;
    position: relative;
  }

  .progress-bar-mini-fill::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
    animation: shimmer 2s linear infinite;
  }

  @keyframes shimmer {
    to { transform: translateX(100%); }
  }

  .display-footer {
    background: linear-gradient(135deg, rgba(13, 82, 64, 0.95), rgba(6, 24, 22, 0.95));
    border-top: 3px solid var(--accent);
    padding: 10px 20px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .footer-section {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 14px;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 10px;
    overflow: hidden;
  }

  .footer-section .footer-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--accent);
    color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .footer-section .footer-icon.red { background: var(--accent-3); }

  .footer-section .footer-text {
    flex: 1;
    overflow: hidden;
    white-space: nowrap;
    position: relative;
  }

  .footer-section .footer-text .ticker-text {
    display: inline-block;
    animation: scrollText 25s linear infinite;
    font-size: 0.85rem;
    color: var(--text);
  }

  .footer-section .footer-text .ticker-text strong {
    color: var(--accent);
    margin-right: 8px;
  }

  @keyframes scrollText {
    0% { transform: translateX(100%); }
    100% { transform: translateX(-100%); }
  }

  .settings-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(8px);
    z-index: 100;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .settings-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .settings-panel {
    position: fixed;
    top: 0;
    right: 0;
    width: 480px;
    max-width: 90vw;
    height: 100vh;
    background: linear-gradient(135deg, #0a1f1a, #1a2e28);
    border-left: 1px solid var(--accent);
    box-shadow: -20px 0 60px rgba(0, 0, 0, 0.6);
    z-index: 101;
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .settings-panel.active {
    transform: translateX(0);
  }

  .settings-header {
    padding: 20px 24px;
    background: linear-gradient(135deg, var(--primary-dark), var(--primary));
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid var(--accent);
    flex-shrink: 0;
  }

  .settings-header h2 {
    font-size: 1.2rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .settings-header h2 i {
    color: var(--accent);
  }

  .close-btn {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: 1px solid var(--card-border);
    background: rgba(0, 0, 0, 0.3);
    color: var(--text);
    cursor: pointer;
    transition: var(--transition);
    font-size: 0.95rem;
  }

  .close-btn:hover {
    background: var(--danger);
    border-color: var(--danger);
  }

  .settings-tabs {
    display: flex;
    padding: 0 20px;
    gap: 4px;
    border-bottom: 1px solid var(--card-border);
    background: rgba(0, 0, 0, 0.2);
    overflow-x: auto;
    flex-shrink: 0;
  }

  .tab-btn {
    padding: 12px 14px;
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 500;
    transition: var(--transition);
    border-bottom: 2px solid transparent;
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    font-family: inherit;
  }

  .tab-btn:hover { color: var(--text); }

  .tab-btn.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .settings-body {
    flex: 1;
    overflow-y: auto;
    padding: 20px 24px;
  }

  .settings-section {
    display: none;
    animation: fadeIn 0.4s ease;
  }

  .settings-section.active { display: block; }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .form-group { margin-bottom: 18px; }

  .form-group label {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 500;
  }

  .form-control {
    width: 100%;
    padding: 11px 14px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--card-border);
    border-radius: 10px;
    color: var(--text);
    font-size: 0.9rem;
    font-family: inherit;
    transition: var(--transition);
  }

  .form-control:focus {
    outline: none;
    border-color: var(--accent);
    background: rgba(255, 255, 255, 0.08);
  }

  textarea.form-control {
    resize: vertical;
    min-height: 70px;
    font-family: inherit;
  }

  .btn {
    padding: 11px 18px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 600;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: inherit;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--accent), #e6a820);
    color: #1a1a1a;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(244, 196, 48, 0.4);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.06);
    color: var(--text);
    border: 1px solid var(--card-border);
  }

  .btn-secondary:hover { background: rgba(255, 255, 255, 0.1); }

  .btn-danger {
    background: rgba(255, 82, 82, 0.15);
    color: var(--danger);
    border: 1px solid rgba(255, 82, 82, 0.3);
  }

  .btn-danger:hover {
    background: var(--danger);
    color: white;
  }

  .btn-block {
    width: 100%;
    justify-content: center;
  }

  .wallpaper-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .wallpaper-item {
    aspect-ratio: 16/10;
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    position: relative;
    transition: var(--transition);
  }

  .wallpaper-item img, .wallpaper-item .gradient-preview {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wallpaper-item:hover { transform: scale(1.05); }
  .wallpaper-item.active { border-color: var(--accent); }

  .wallpaper-item .check {
    position: absolute;
    top: 5px;
    right: 5px;
    width: 22px;
    height: 22px;
    background: var(--accent);
    border-radius: 50%;
    display: none;
    align-items: center;
    justify-content: center;
    color: #1a1a1a;
    font-size: 0.7rem;
  }

  .wallpaper-item.active .check { display: flex; }

  .alarm-list, .schedule-list-settings {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 14px;
  }

  .alarm-item {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 12px 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: var(--transition);
  }

  .alarm-item:hover { background: rgba(255, 255, 255, 0.08); }

  .alarm-info { flex: 1; min-width: 0; }

  .alarm-time {
    font-family: 'Orbitron', sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--accent);
  }

  .alarm-details {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 3px;
    word-break: break-word;
  }

  .alarm-actions {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }

  .icon-btn {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    border: 1px solid var(--card-border);
    background: var(--card-bg);
    color: var(--text);
    cursor: pointer;
    transition: var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
  }

  .icon-btn:hover { background: rgba(255, 255, 255, 0.1); }

  .toggle-switch {
    position: relative;
    width: 44px;
    height: 24px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50px;
    cursor: pointer;
    transition: var(--transition);
    flex-shrink: 0;
  }

  .toggle-switch.active { background: var(--success); }

  .toggle-switch::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    background: white;
    border-radius: 50%;
    transition: var(--transition);
  }

