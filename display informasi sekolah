    try {
      const parsed = JSON.parse(saved);
      Object.assign(state, parsed);
    } catch (e) {
      console.error('Load error', e);
    }
  }
  if (!state.schedules || state.schedules.length === 0) {
    state.schedules = defaultSchedules;
  }
}

const days = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
const months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];

function updateClock() {
  const now = new Date();
  const day = days[now.getDay()];
  const date = now.getDate();
  const month = months[now.getMonth()];
  const year = now.getFullYear();
  
  const hours = String(now.getHours()).padStart(2, '0');
  const minutes = String(now.getMinutes()).padStart(2, '0');
  const seconds = String(now.getSeconds()).padStart(2, '0');
  
  document.getElementById('dayDate').textContent = `${day}, ${date} ${month} ${year}`;
  document.getElementById('currentTime').textContent = `${hours}:${minutes}:${seconds}`;
  document.getElementById('clockTime').textContent = `${hours}:${minutes}`;
  document.getElementById('clockSeconds').textContent = seconds;
  
  updateActivity();
  checkAlarms();
}

function timeToMinutes(t) {
  const [h, m] = t.split(':').map(Number);
  return h * 60 + m;
}

function getCurrentSchedules() {
  const now = new Date();
  const currentMin = now.getHours() * 60 + now.getMinutes();
  return state.schedules.filter(s => 
    timeToMinutes(s.start) <= currentMin && 
    timeToMinutes(s.end) > currentMin
  );
}

function getNextSchedules() {
  const now = new Date();
  const currentMin = now.getHours() * 60 + now.getMinutes();
  return state.schedules.filter(s => timeToMinutes(s.start) > currentMin)
    .sort((a, b) => timeToMinutes(a.start) - timeToMinutes(b.start));
}

function updateActivity() {
  const current = getCurrentSchedules();
  const next = getNextSchedules();
  
  if (current.length > 0) {
    const first = current[0];
    document.getElementById('currentActivityLabel').textContent = `${first.class} - ${first.subject}`;
    document.getElementById('activityTimeLabel').textContent = `${first.start} - ${first.end}`;
    
    const now = new Date();
    const currentMin = now.getHours() * 60 + now.getMinutes() + now.getSeconds() / 60;
    const startMin = timeToMinutes(first.start);
    const endMin = timeToMinutes(first.end);
    const progress = ((currentMin - startMin) / (endMin - startMin)) * 100;
    document.getElementById('progressBar').style.width = Math.min(100, Math.max(0, progress)) + '%';
  } else {
    document.getElementById('currentActivityLabel').textContent = 'Tidak Ada Kegiatan';
    document.getElementById('activityTimeLabel').textContent = '--:-- - --:--';
    document.getElementById('progressBar').style.width = '0%';
  }
  
  renderScheduleLists();
}

function renderScheduleLists() {
  const leftList = document.getElementById('scheduleListLeft');
  const rightList = document.getElementById('scheduleListRight');
  
  const current = getCurrentSchedules();
  const next = getNextSchedules();
  const currentIds = current.map(s => s.id);
  const nextFirstId = next.length > 0 ? next[0].id : -1;
  
  const leftSchedules = state.schedules.filter(s => s.column === 'left')
    .sort((a, b) => timeToMinutes(a.start) - timeToMinutes(b.start));
  const rightSchedules = state.schedules.filter(s => s.column === 'right')
    .sort((a, b) => timeToMinutes(a.start) - timeToMinutes(b.start));
  
  leftList.innerHTML = renderScheduleItems(leftSchedules, currentIds, nextFirstId);
  rightList.innerHTML = renderScheduleItems(rightSchedules, currentIds, nextFirstId);
}

function renderScheduleItems(schedules, currentIds, nextFirstId) {
  if (schedules.length === 0) {
    return '<p style="text-align: center; color: rgba(255,255,255,0.5); padding: 20px; font-size: 0.85rem;">Tidak ada jadwal</p>';
  }
  
  return schedules.map(s => {
    let cls = '';
    let badge = '';
    if (currentIds.includes(s.id)) {
      cls = 'active';
      badge = '<span class="badge">SEDANG BERLANGSUNG</span>';
    } else if (s.id === nextFirstId) {
      cls = 'next';
      badge = '<span class="badge">BERIKUTNYA</span>';
    }
    
    return `
      <div class="schedule-card ${cls}">
        <div class="class-name">
          <span>${s.class}</span>
          ${badge}
        </div>
        <div class="class-time">
          <i class="far fa-clock"></i> ${s.start} - ${s.end}
        </div>
        <div class="class-subject">
          <i class="fas fa-book"></i> ${s.subject}
        </div>
      </div>
    `;
  }).join('');
}

let alarmAudio = null;
let beepCtx = null;
let beepInterval = null;

function checkAlarms() {
  const now = new Date();
  const currentTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
  const sec = now.getSeconds();
  
  if (sec !== 0) return;
  
  state.alarms.forEach(alarm => {
    if (alarm.enabled && alarm.time === currentTime && !alarm.triggered) {
      triggerAlarm(alarm);
      alarm.triggered = true;
      setTimeout(() => { alarm.triggered = false; }, 65000);
    }
  });
}

function triggerAlarm(alarm) {
  stopAlarmAudio();
  
  if (alarm.music) {
    alarmAudio = new Audio(alarm.music);
    alarmAudio.volume = state.volume / 100;
    alarmAudio.loop = true;
    alarmAudio.play().catch(e => {
      console.warn('Audio failed', e);
      showToast('Klik halaman untuk mengaktifkan audio', 'info');
    });
  } else {
    startBeepAlarm();
  }
  
  document.getElementById('alarmModalTitle').textContent = alarm.label || 'Alarm Berbunyi!';
  document.getElementById('alarmModalLabel').textContent = `Pukul ${alarm.time}`;
  document.getElementById('alarmModal').classList.add('show');
}

function startBeepAlarm() {
  try {
    beepCtx = new (window.AudioContext || window.webkitAudioContext)();
    const vol = state.volume / 100;
    
    const playBeep = () => {
      const osc = beepCtx.createOscillator();
      const gain = beepCtx.createGain();
      osc.connect(gain);
      gain.connect(beepCtx.destination);
      osc.frequency.value = 880;
      osc.type = 'sine';
      gain.gain.setValueAtTime(vol, beepCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, beepCtx.currentTime + 0.5);
      osc.start();
      osc.stop(beepCtx.currentTime + 0.5);
    };
    
    playBeep();
    beepInterval = setInterval(playBeep, 1000);
  } catch (e) {
    console.error('Beep failed', e);
  }
}

function stopAlarmAudio() {
  if (alarmAudio) {
    try { alarmAudio.pause(); alarmAudio.currentTime = 0; } catch(e) {}
    alarmAudio = null;
  }
  if (beepInterval) {
    clearInterval(beepInterval);
    beepInterval = null;
  }
  if (beepCtx) {
    try { beepCtx.close(); } catch(e) {}
    beepCtx = null;
  }
}

function stopAlarm() {
  stopAlarmAudio();
  document.getElementById('alarmModal').classList.remove('show');
}

function updateAlarmList() {
  const list = document.getElementById('alarmList');
  
  if (state.alarms.length === 0) {
    list.innerHTML = '<p style="text-align: center; color: var(--text-muted); padding: 20px;">Belum ada alarm</p>';
    return;
  }
  
  list.innerHTML = state.alarms.map(alarm => `
    <div class="alarm-item">
      <div class="alarm-info">
        <div class="alarm-time">${alarm.time}</div>
        <div class="alarm-details">
          ${alarm.label || 'Alarm'} ${alarm.musicName ? '• ' + alarm.musicName : '• Default beep'}
        </div>
      </div>
      <div class="alarm-actions">
        <div class="toggle-switch ${alarm.enabled ? 'active' : ''}" data-id="${alarm.id}" data-action="toggle"></div>
        <button class="icon-btn" data-id="${alarm.id}" data-action="test" title="Tes">
          <i class="fas fa-play"></i>
        </button>
        <button class="icon-btn" data-id="${alarm.id}" data-action="delete" title="Hapus" style="color: var(--danger);">
          <i class="fas fa-trash"></i>
        </button>
      </div>
    </div>
  `).join('');
}

function applyWallpaper() {
  const layer = document.getElementById('wallpaper-layer');
  document.documentElement.style.setProperty('--bg-overlay', `rgba(6, 24, 22, ${state.wallpaper.overlay / 100})`);
  
  if (state.wallpaper.type === 'preset') {
    const preset = presetWallpapers.find(w => w.id === state.wallpaper.value);
    if (preset) {
      if (preset.type === 'gradient') {
        layer.style.background = preset.url;
        layer.style.backgroundImage = 'none';
      } else {
        layer.style.backgroundImage = `url("${preset.url}")`;
      }
    }
  } else if (state.wallpaper.type === 'url') {
    layer.style.backgroundImage = `url("${state.wallpaper.value}")`;
  } else if (state.wallpaper.type === 'custom' && state.wallpaper.custom) {
    layer.style.backgroundImage = `url("${state.wallpaper.custom}")`;
  }
}

function renderWallpaperGrid() {
  const grid = document.getElementById('wallpaperGrid');
  grid.innerHTML = presetWallpapers.map(w => `
    <div class="wallpaper-item ${state.wallpaper.type === 'preset' && state.wallpaper.value === w.id ? 'active' : ''}" data-id="${w.id}">
      ${w.type === 'gradient' 
        ? `<div class="gradient-preview" style="background: ${w.url};"></div>` 
        : `<img src="${w.url}" alt="${w.name}" loading="lazy">`}
      <div class="check"><i class="fas fa-check"></i></div>
    </div>
  `).join('');
}

function applyBuildingImage() {
  const img = document.getElementById('buildingImg');
  document.getElementById('buildingTitle').textContent = state.building.title;
  document.getElementById('buildingSubtitle').textContent = state.building.subtitle;
  
  if (state.building.custom) {
    img.src = state.building.custom;
  } else {
    img.src = state.building.image;
  }
}

function createParticles() {
  const container = document.getElementById('particles');
  container.innerHTML = '';
  for (let i = 0; i < 15; i++) {
    const p = document.createElement('div');
    p.className = 'particle';
    const size = Math.random() * 4 + 2;
    p.style.width = size + 'px';
    p.style.height = size + 'px';
    p.style.left = Math.random() * 100 + '%';
    p.style.animationDuration = (Math.random() * 20 + 15) + 's';
    p.style.animationDelay = Math.random() * 20 + 's';
    p.style.opacity = Math.random() * 0.4 + 0.15;
    container.appendChild(p);
  }
}

function showToast(message, type) {
  type = type || 'info';
  const toast = document.getElementById('toast');
  const icon = toast.querySelector('i');
  
  toast.className = 'toast ' + type;
  icon.className = type === 'success' ? 'fas fa-check-circle' 
    : type === 'error' ? 'fas fa-exclamation-circle' 
    : 'fas fa-info-circle';
  
  document.getElementById('toastMessage').textContent = message;
  toast.classList.add('show');
  
  setTimeout(() => toast.classList.remove('show'), 3000);
}

function openSettings() {
  document.getElementById('settingsOverlay').classList.add('active');
  document.getElementById('settingsPanel').classList.add('active');
  
  document.getElementById('setSchoolName').value = state.school.name;
  document.getElementById('setSchoolAddress').value = state.school.address;
  document.getElementById('setSchoolWebsite').value = state.school.website;
  document.getElementById('setSchoolLogo').value = state.school.logo;
  document.getElementById('setArabic').value = state.school.arabic;
  document.getElementById('setMotto').value = state.school.motto;
  document.getElementById('volumeSlider').value = state.volume;
  document.getElementById('volumeValue').textContent = state.volume + '%';
  document.getElementById('setAnnouncement1').value = state.announcements.left;
  document.getElementById('setAnnouncement2').value = state.announcements.right;
  document.getElementById('overlaySlider').value = state.wallpaper.overlay;
  document.getElementById('overlayValue').textContent = state.wallpaper.overlay + '%';
  document.getElementById('setBuildingTitle').value = state.building.title;
  document.getElementById('setBuildingSubtitle').value = state.building.subtitle;
  document.getElementById('setBuildingImg').value = state.building.image;
  
  renderWallpaperGrid();
  updateAlarmList();
  updateScheduleListSettings();
}

function closeSettings() {
  document.getElementById('settingsOverlay').classList.remove('active');
  document.getElementById('settingsPanel').classList.remove('active');
}

function updateScheduleListSettings() {
  const list = document.getElementById('scheduleListSettings');
  
  if (state.schedules.length === 0) {
    list.innerHTML = '<p style="text-align: center; color: var(--text-muted); padding: 20px;">Belum ada jadwal</p>';
    return;
  }
  
  const sorted = [...state.schedules].sort((a, b) => timeToMinutes(a.start) - timeToMinutes(b.start));
  
  list.innerHTML = sorted.map(s => `
    <div class="alarm-item">
      <div class="alarm-info">
        <div class="alarm-time">${s.start} - ${s.end}</div>
        <div class="alarm-details">${s.class} • ${s.subject} • ${s.column === 'left' ? 'Kiri' : 'Kanan'}</div>
      </div>
      <div class="alarm-actions">
        <button class="icon-btn" data-id="${s.id}" data-action="delete-schedule" style="color: var(--danger);">
          <i class="fas fa-trash"></i>
        </button>
      </div>
    </div>
  `).join('');
}

function applySettings() {
  document.getElementById('schoolName').textContent = state.school.name;
  document.getElementById('schoolAddress').textContent = state.school.address;
  document.getElementById('schoolWebsite').textContent = state.school.website;
  document.getElementById('schoolLogo').textContent = state.school.logo;
  document.getElementById('arabicText').textContent = state.school.arabic;
  document.querySelector('.header-center .motto').textContent = state.school.motto;
  document.getElementById('footerAnnouncement1').textContent = state.announcements.left;
  document.getElementById('footerAnnouncement2').textContent = state.announcements.right;
  applyBuildingImage();
}

document.getElementById('openSettings').addEventListener('click', openSettings);
document.getElementById('closeSettings').addEventListener('click', closeSettings);
document.getElementById('settingsOverlay').addEventListener('click', closeSettings);

document.querySelectorAll('.tab-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.settings-section').forEach(s => s.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
  });
});

document.getElementById('saveGeneral').addEventListener('click', () => {
  state.school.name = document.getElementById('setSchoolName').value;
  state.school.address = document.getElementById('setSchoolAddress').value;
  state.school.website = document.getElementById('setSchoolWebsite').value;
  state.school.logo = document.getElementById('setSchoolLogo').value.toUpperCase();
  state.school.arabic = document.getElementById('setArabic').value;
  state.school.motto = document.getElementById('setMotto').value;
  state.announcements.left = document.getElementById('setAnnouncement1').value;
  state.announcements.right = document.getElementById('setAnnouncement2').value;
  
  applySettings();
  saveState();
  showToast('Pengaturan berhasil disimpan', 'success');
});

document.getElementById('volumeSlider').addEventListener('input', (e) => {
  state.volume = parseInt(e.target.value);
  document.getElementById('volumeValue').textContent = state.volume + '%';
});

document.getElementById('overlaySlider').addEventListener('input', (e) => {
  state.wallpaper.overlay = parseInt(e.target.value);
  document.getElementById('overlayValue').textContent = state.wallpaper.overlay + '%';
  applyWallpaper();
});

document.getElementById('wallpaperGrid').addEventListener('click', (e) => {
  const item = e.target.closest('.wallpaper-item');
  if (!item) return;
  
  state.wallpaper.type = 'preset';
  state.wallpaper.value = item.dataset.id;
  state.wallpaper.custom = null;
  
  renderWallpaperGrid();
  applyWallpaper();
  saveState();
  showToast('Wallpaper diganti', 'success');
});

document.getElementById('applyWallpaperUrl').addEventListener('click', () => {
  const url = document.getElementById('wallpaperUrl').value.trim();
  if (!url) {
    showToast('Masukkan URL gambar', 'error');
    return;
  }
  state.wallpaper.type = 'url';
  state.wallpaper.value = url;
  state.wallpaper.custom = null;
  applyWallpaper();
  saveState();
  showToast('Wallpaper diterapkan', 'success');
});

document.getElementById('wallpaperFile').addEventListener('change', (e) => {
  const file = e.target.files[0];
  if (!file) return;
  if (file.size > 5 * 1024 * 1024) {
    showToast('Ukuran file terlalu besar (max 5MB)', 'error');
    return;
  }
  const reader = new FileReader();
  reader.onload = (ev) => {
    state.wallpaper.type = 'custom';
    state.wallpaper.custom = ev.target.result;
    state.wallpaper.value = null;
    applyWallpaper();
    saveState();
    showToast('Wallpaper diupload', 'success');
  };
  reader.readAsDataURL(file);
});

document.getElementById('resetWallpaper').addEventListener('click', () => {
  state.wallpaper.type = 'preset';
  state.wallpaper.value = 'gradient1';
  state.wallpaper.custom = null;
  state.wallpaper.overlay = 82;
  document.getElementById('overlaySlider').value = 82;
  document.getElementById('overlayValue').textContent = '82%';
  renderWallpaperGrid();
  applyWallpaper();
  saveState();
  showToast('Wallpaper direset', 'success');
});

document.getElementById('addAlarm').addEventListener('click', () => {
  const time = document.getElementById('newAlarmTime').value;
  const label = document.getElementById('newAlarmLabel').value;
  const musicFile = document.getElementById('alarmMusicFile').files[0];
  
  if (!time) {
    showToast('Pilih waktu alarm', 'error');
    return;
  }
  
  const alarm = {
    id: Date.now(),
    time: time,
    label: label || 'Alarm',
    music: null,
    musicName: '',
    enabled: true,
    triggered: false
  };
  
  if (musicFile) {
    if (musicFile.size > 5 * 1024 * 1024) {
      showToast('Ukuran file musik terlalu besar (max 5MB)', 'error');
      return;
    }
    const reader = new FileReader();
    reader.onload = (ev) => {
      alarm.music = ev.target.result;
      alarm.musicName = musicFile.name;
      state.alarms.push(alarm);
      updateAlarmList();
      saveState();
      document.getElementById('newAlarmTime').value = '';
      document.getElementById('newAlarmLabel').value = '';
      document.getElementById('alarmMusicFile').value = '';
      document.getElementById('alarmMusicName').textContent = 'Pilih file MP3 (atau gunakan alarm default)';
      showToast('Alarm ditambahkan', 'success');
    };
    reader.readAsDataURL(musicFile);
  } else {
    state.alarms.push(alarm);
    updateAlarmList();
    saveState();
    document.getElementById('newAlarmTime').value = '';
    document.getElementById('newAlarmLabel').value = '';
    showToast('Alarm ditambahkan', 'success');
  }
});

document.getElementById('alarmMusicFile').addEventListener('change', (e) => {
  const file = e.target.files[0];
  document.getElementById('alarmMusicName').textContent = file ? file.name : 'Pilih file MP3 (atau gunakan alarm default)';
});

document.getElementById('alarmList').addEventListener('click', (e) => {
  const btn = e.target.closest('[data-action]');
  if (!btn) return;
  const id = parseInt(btn.dataset.id);
  const action = btn.dataset.action;
  const alarm = state.alarms.find(a => a.id === id);
  if (!alarm) return;
  
  if (action === 'toggle') {
    alarm.enabled = !alarm.enabled;
    updateAlarmList();
    saveState();
  } else if (action === 'test') {
    triggerAlarm(alarm);
  } else if (action === 'delete') {
    state.alarms = state.alarms.filter(a => a.id !== id);
    updateAlarmList();
    saveState();
    showToast('Alarm dihapus', 'success');
  }
});

document.getElementById('testAlarm').addEventListener('click', () => {
  triggerAlarm({
    id: 0,
    time: 'now',
    label: 'Tes Alarm',
    music: null,
    enabled: true
  });
});

document.getElementById('stopAlarm').addEventListener('click', stopAlarm);

document.getElementById('addSchedule').addEventListener('click', () => {
  const cls = document.getElementById('newScheduleClass').value;
  const subject = document.getElementById('newScheduleSubject').value;
  const start = document.getElementById('newScheduleStart').value;
  const end = document.getElementById('newScheduleEnd').value;
  const column = document.getElementById('newScheduleColumn').value;
  
  if (!cls || !subject || !start || !end) {
    showToast('Lengkapi semua field', 'error');
    return;
  }
  if (start >= end) {
    showToast('Waktu selesai harus lebih besar', 'error');
    return;
  }
  
  state.schedules.push({
    id: Date.now(),
    class: cls,
    subject: subject,
    start: start,
    end: end,
    column: column
  });
  
  updateScheduleListSettings();
  saveState();
  
  document.getElementById('newScheduleClass').value = '';
  document.getElementById('newScheduleSubject').value = '';
  document.getElementById('newScheduleStart').value = '';
  document.getElementById('newScheduleEnd').value = '';
  
  showToast('Jadwal ditambahkan', 'success');
});

document.getElementById('scheduleListSettings').addEventListener('click', (e) => {
  const btn = e.target.closest('[data-action="delete-schedule"]');
  if (!btn) return;
  const id = parseInt(btn.dataset.id);
  state.schedules = state.schedules.filter(s => s.id !== id);
  updateScheduleListSettings();
  saveState();
  showToast('Jadwal dihapus', 'success');
});

document.getElementById('clearSchedule').addEventListener('click', () => {
  if (confirm('Hapus semua jadwal?')) {
    state.schedules = [];
    updateScheduleListSettings();
    saveState();
    showToast('Semua jadwal dihapus', 'success');
  }
});

document.getElementById('saveImage').addEventListener('click', () => {
  state.building.title = document.getElementById('setBuildingTitle').value;
  state.building.subtitle = document.getElementById('setBuildingSubtitle').value;
  const imgUrl = document.getElementById('setBuildingImg').value.trim();
  if (imgUrl) {
    state.building.image = imgUrl;
    state.building.custom = null;
  }
  applyBuildingImage();
  saveState();
  showToast('Foto disimpan', 'success');
});

document.getElementById('buildingFile').addEventListener('change', (e) => {
  const file = e.target.files[0];
  if (!file) return;
  if (file.size > 5 * 1024 * 1024) {
    showToast('Ukuran file terlalu besar (max 5MB)', 'error');
    return;
  }
  const reader = new FileReader();
  reader.onload = (ev) => {
    state.building.custom = ev.target.result;
    applyBuildingImage();
    saveState();
    showToast('Foto diupload', 'success');
  };
  reader.readAsDataURL(file);
});

document.addEventListener('click', () => {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    ctx.resume();
  } catch(e) {}
}, { once: true });

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    if (document.getElementById('alarmModal').classList.contains('show')) {
      stopAlarm();
    } else if (document.getElementById('settingsPanel').classList.contains('active')) {
      closeSettings();
    }
  }
});

function init() {
  loadState();
  applySettings();
  applyWallpaper();
  createParticles();
  updateClock();
  setInterval(updateClock, 1000);
  setInterval(createParticles, 60000);
}

init();
